[Unit]
Description=Bobby Hedgefund: prices failure alert

[Service]
Type=oneshot
# Home Assistant may still be starting (a catch-up run right after boot): try for up to ~10 minutes
ExecStart=/bin/bash -c 'for i in $(seq 1 20); do "$HOME/server/tools/send_ha_message.sh" "Bobby prices" "The morning download of prices had a failure. See: bobby-prices status" && exit 0; sleep 30; done; exit 1'
